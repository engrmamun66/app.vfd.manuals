# Server binding (local only by default — do not expose to a wider network without a security review)
HOST=127.0.0.1
PORT=3000

# Initial Super Admin bootstrap (only used when no Super Admin exists; never resets an existing one)
INITIAL_SUPERADMIN_EMAIL=admin@vfd.local
INITIAL_SUPERADMIN_PASSWORD=change-me-to-a-strong-password

# Sessions
SESSION_TTL_DAYS=7
# Set to true only when served over HTTPS
COOKIE_SECURE=false

# Rate limits
REGISTRATION_RATE_LIMIT_MAX=3
REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=60
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Comma-separated list of trusted reverse-proxy IPs. Empty = never trust X-Forwarded-For.
TRUSTED_PROXIES=

# Storage defaults (bytes) — Super Admin can override per user
DEFAULT_USER_QUOTA_BYTES=524288000
DEFAULT_MAX_UPLOAD_BYTES=10485760
DEFAULT_MAX_ATTACHMENTS_PER_COMMENT=8
